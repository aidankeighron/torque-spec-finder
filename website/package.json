{
  "name": "torque-spec-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Natural-language torque spec lookup that refuses to guess. Static Next.js, no backend, no database.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.2.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
